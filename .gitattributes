# Text files are stored and checked out with LF so that expected outputs
# compare byte for byte on every platform.
* text=auto eol=lf

*.py     text diff=python
*.md     text diff=markdown
*.json   text
*.csv    text
*.ipynb  text
*.mmd    text
*.yml    text
*.svg    text

*.pdf    binary
*.png    binary
*.jpg    binary

# Dataset CSVs keep their original CRLF bytes. The public Messina sample
# must stay identical to the municipal file, which uses CRLF.
datasets/*.csv -text
